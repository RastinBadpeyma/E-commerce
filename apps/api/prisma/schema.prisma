generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  schemas  = ["identity", "product", "order"] 

}


enum UserRole {
  ADMIN
  CUSTOMER
  @@schema("identity")
}
model User {
  id        String   @id @default(uuid())
  phoneNumber String   @unique
  role        UserRole @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  @@schema("identity")
}
model OtpCode {
  id          String   @id @default(uuid())

  phoneNumber String

  code        String

  expiresAt   DateTime

  usedAt      DateTime?

  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@schema("identity")
}

model RefreshToken {
  id        String   @id @default(uuid())

  tokenHash String   @unique

  userId    String

  user      User @relation(fields: [userId], references: [id])

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("identity")
}

enum ProductsStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  @@schema("product")
}
model Product {
  id          String   @id @default(uuid())
  title       String
  slug        String @unique
  description String?
  price       Decimal   @db.Decimal(10, 2)
  status      ProductsStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt, id, slug]) 
  @@schema("product")
}

model Stock {
  id        String   @id @default(uuid())

  productId String   @unique

  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations StockReservation[]

  @@schema("product")
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED

  @@schema("product")
}

model StockReservation {
  id        String   @id @default(uuid())

  productId String

  quantity  Int

  orderId   String? 

  status    StockReservationStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock Stock @relation(fields: [productId], references: [productId])

  @@index([productId, status])
  @@index([orderId])          
  @@index([expiresAt])
  @@index([status, expiresAt])

  @@schema("product")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED

  @@schema("order")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(PENDING)

  totalAmount Decimal     @db.Decimal(12, 2)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]

  @@index([userId])
  @@index([createdAt])
  @@schema("order")
}

model OrderItem {
  id          String   @id @default(uuid())

  orderId     String
  productId   String

  quantity    Int

  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])

  @@schema("order")
}




